{
  "name": "openvla-asv-inspection",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-runtime.mjs && vite --host 127.0.0.1",
    "build": "node scripts/copy-runtime.mjs && vite build",
    "tauri": "tauri",
    "desktop": "tauri build --no-bundle && node scripts/export-exe.mjs",
    "test:commands": "node test/commands.mjs && node test/rrt-star.mjs",
    "test:shore": "node test/shore-arm.mjs",
    "test:cleanup": "node test/cleanup.mjs && node test/shore-arm.mjs && python scripts/check_cleanup_vision.py --full"
  },
  "dependencies": {
    "three": "0.180.0",
    "onnxruntime-web": "1.22.0",
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "vite": "^7.2.2",
    "@tauri-apps/cli": "^2.9.0"
  }
}
